rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'isPremium', 'premiumPlan', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'isPremium', 'premiumPlan', 'premiumSince', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.isPremium is bool
        && data.premiumPlan in ['free', 'monthly', 'yearly']
        && data.isPremium == (data.premiumPlan != 'free')
        && (!('premiumSince' in data) || (data.premiumSince is string && data.premiumSince.size() <= 50))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavorite(data, userId, mediaId) {
      return data.keys().hasAll(['userId', 'mediaId', 'mediaType', 'title', 'addedAt'])
        && data.keys().hasOnly(['userId', 'mediaId', 'mediaType', 'title', 'addedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.mediaId)
        && data.mediaId == mediaId
        && data.mediaId.size() <= 64
        && data.mediaType in ['anime', 'movie']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.addedAt is timestamp;
    }

    function isValidWatchHistory(data, userId, mediaId) {
      return data.keys().hasAll(['userId', 'mediaId', 'mediaType', 'title', 'genres', 'episode', 'progressPercent', 'watchedAt'])
        && data.keys().hasOnly(['userId', 'mediaId', 'mediaType', 'title', 'genres', 'episode', 'progressPercent', 'watchedAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidId(data.mediaId)
        && data.mediaId == mediaId
        && data.mediaId.size() <= 64
        && data.mediaType in ['anime', 'movie']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.genres is list && data.genres.size() >= 1 && data.genres.size() <= 5
        && data.genres[0] is string && data.genres[0].size() >= 1 && data.genres[0].size() <= 40
        && data.episode is int && data.episode >= 1 && data.episode <= 2000
        && data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.watchedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().isPremium == false
        && incoming().premiumPlan == 'free'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['isPremium', 'premiumPlan', 'premiumSince', 'updatedAt'])
        );

      allow delete: if false;

      match /favorites/{mediaId} {
        allow get: if isValidId(userId) && isValidId(mediaId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(mediaId)
          && isOwner(userId)
          && isValidFavorite(incoming(), userId, mediaId)
          && incoming().addedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(mediaId)
          && isOwner(userId);
      }

      match /watchHistory/{mediaId} {
        allow get: if isValidId(userId) && isValidId(mediaId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(mediaId)
          && isOwner(userId)
          && isValidWatchHistory(incoming(), userId, mediaId)
          && incoming().watchedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(mediaId)
          && isOwner(userId)
          && isValidWatchHistory(incoming(), userId, mediaId)
          && incoming().userId == existing().userId
          && incoming().mediaId == existing().mediaId
          && incoming().mediaType == existing().mediaType
          && incoming().title == existing().title
          && incoming().watchedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['episode', 'progressPercent', 'genres', 'watchedAt']);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(mediaId)
          && isOwner(userId);
      }
    }
  }
}
